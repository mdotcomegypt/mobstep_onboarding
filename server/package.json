{
  "name": "@mobstep/onboarding-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-info.mjs",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "migrate": "node --env-file-if-exists=../.env --experimental-strip-types src/db/migrate.ts",
    "preflight": "node --env-file-if-exists=../.env --experimental-strip-types src/preflight.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "sim": "node --experimental-strip-types sim/run.ts",
    "sim:recovery": "node --experimental-strip-types sim/recovery.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.1",
    "@langchain/core": "^0.3.40",
    "@langchain/google-vertexai": "^0.2.0",
    "@langchain/langgraph": "^0.2.44",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.4",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
