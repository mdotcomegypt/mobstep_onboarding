# --- HTTP -------------------------------------------------------------------
PORT=8080
PUBLIC_ORIGIN=https://onboarding.mobstep.com

# --- Drupal handoff ---------------------------------------------------------
# Must equal $settings['onboarding_secret'] on the Drupal side.
ONBOARDING_SECRET=
# Must equal $settings['apps.mobld_secret'] on the Drupal side.
MOBLD_SECRET=
DRUPAL_BASE_URL=https://mobstep.com

# --- Session ----------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=

# --- Postgres ---------------------------------------------------------------
DATABASE_URL=postgres://onboarding:onboarding@127.0.0.1:5432/mobstep_onboarding

# --- Uploads ----------------------------------------------------------------
# Menu photos, logos. Must be writable by the service user and persistent.
# Must be writable by the service user and, under systemd, inside
# ReadWritePaths. The process refuses to start if it is not.
UPLOAD_DIR=/opt/mobstep_onboarding/uploads

# --- WhatsApp (Mobstep platform WABA) ---------------------------------------
WA_BUSINESS_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_OTP_TEMPLATE=mobstep_otp_for_all
WA_API_VERSION=v21.0

# --- Debugging ---------------------------------------------------------------
# Enables GET /api/debug/log?key=…  Leave EMPTY to disable the route entirely
# (it 404s when unset). Rotate it if you share a trace.
DEBUG_KEY=

# --- Vertex AI --------------------------------------------------------------
# The service account needs the Vertex AI User role ON THIS PROJECT. A key from
# a different project authenticates fine and then 403s on every generate call,
# which reads as a model problem rather than an IAM one — `pnpm preflight`
# checks this explicitly for that reason.
GOOGLE_CLOUD_PROJECT=mob-step
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/opt/mobstep_onboarding/.secrets/vertex-sa.json
MODEL_CHAT=gemini-2.5-flash
MODEL_REASON=gemini-2.5-pro
MODEL_IMAGE=gemini-2.5-flash-image

# Image quota is granted PER REGION, and the image model's allowance is much
# tighter than the chat model's — one region alone sustains roughly one
# generation every forty seconds, which is not enough for a set of category
# icons. Generation rotates across these on a 429 rather than waiting, so more
# regions means a faster batch. Comma-separated, tried in order of least-recent
# rejection.
VERTEX_IMAGE_LOCATIONS=global,us-east4,europe-west4

# How many Vertex requests may be in flight at once, across the whole process.
# Measured: requests one after another all succeed, six at once do not — the
# quota is a concurrency limit, so this matters more than any retry setting.
VERTEX_MAX_IN_FLIGHT=2
VERTEX_MIN_GAP_MS=220
